      "title": "Always call removeEventListener in the component unmount/destroy hook.",
    },
  ],
  "confidenceScore": 90,
  "estimates": {
    "memoryReduction": "~25% footprint reduction",
    "performanceGain": "Moderate (+15% FPS)",
    "renderingImprovement": "Minimal",
    "timeToFix": "< 5 mins",
  },
  "issues": [
    {
      "autoFix": {
        "badCode": "window.addEventListener("resize", handleResize);",
        "recommendedCode": "onMounted(() => window.addEventListener("resize", handleResize));
onUnmounted(() => window.removeEventListener("resize", handleResize));",
        "whyFaster": "Explicitly removing listeners breaks the reference cycle, allowing the V8 Garbage Collector to instantly free the memory associated with the destroyed component.",
      },
      "browserAPIs": [
        "addEventListener",
        "removeEventListener",
      ],
      "browserImpact": {
        "cpu": false,
        "cwv": false,
        "memory": true,
        "network": false,
        "rendering": false,
      },
