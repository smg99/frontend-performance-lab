          "Layout",
          "Paint",
        ],
        "whatHappened": "A style property is being mutated directly in the DOM, potentially interleaving with a DOM read.",
        "whyBrowserBehavesThisWay": "When you read a layout property (like offsetHeight) after modifying styles, the browser is forced to pause JavaScript execution and recalculate the entire page layout synchronously to give you the correct value. This is called Forced Synchronous Layout.",
      },
      "filename": "app.js",
